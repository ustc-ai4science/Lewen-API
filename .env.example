# Copy to .env. Run all scripts from the repository root.
GPU_DEVICE_ID=0
UVICORN_WORKERS=1
QDRANT_HOST=localhost
QDRANT_PORT=6334
# QDRANT_PATH intentionally omitted: the published archive is server storage.

# Local trial. Set true and create your own keys before exposing the API.
AUTH_ENABLED=false
ADMIN_SECRET=
AUTH_CACHE_TTL=60
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4100
ADMIN_TARGET_API_BASE_URL=http://localhost:4000

# Needed for Semantic Scholar incremental downloads, not local queries.
S2_API_KEY=

# BGE_M3_MODEL_PATH, API_HOST and API_PORT are configured in config.py;
# they are not read from environment variables in the current implementation.
